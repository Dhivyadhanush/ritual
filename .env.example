# Copy to .env and edit. Never commit .env.
# No real credentials belong in this repository.

# --- server ---
PORT=4322
HOST=0.0.0.0
# Docker: UID/GID that own ./data (default 1000).
PUID=1000
PGID=1000
# Leave DATA_DIR unset in Docker (the image uses /data).
# DATA_DIR=./data

# --- ntfy delivery ---
# Public ntfy.sh, or your self-hosted ntfy URL.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_DRY_RUN=true
NTFY_MIN_PRIORITY=3
# URL your phone can reach, used for notification buttons.
# Examples: http://your-host:4322 or https://ritual.example.com
HEALTH_BASE_URL=

# --- profile / schedule ---
HEALTH_NAME=there
HEALTH_WAKE=07:00
HEALTH_SLEEP=22:30
HEALTH_WATER_GOAL=8
HEALTH_STEP_GOAL=8000

# --- single-user login (no sign-up) ---
AUTH_USER=admin
# Generate with: node scripts/hash-password.mjs "your password"
AUTH_PASSWORD_HASH=
# Legacy plaintext fallback for local development only:
# DASHBOARD_USER=
# DASHBOARD_PASS=

# --- optional ---
# Token required by POST /api/watch
HEALTH_WATCH_TOKEN=
# Protects /a/water and /a/checkin (notification buttons).
# Generate with: openssl rand -hex 24
ACTION_TOKEN=
# Optional weather-ntfy state file, e.g. /path/to/weather-ntfy/data/state.json
# WEATHER_STATE_FILE=
